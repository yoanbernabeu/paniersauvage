# Production settings of Panier Sauvage.
# Copy to .env.prod on the server (chmod 600) and fill in every value. Never commit .env.prod.
# Used by: docker compose --env-file .env.prod -f compose.prod.yaml ...

###> Docker / Caddy ###
# Image published by .github/workflows/deploy.yml (lowercase owner/repository).
APP_IMAGE=ghcr.io/OWNER/panier-sauvage:latest
# Public domain: Caddy requests and renews the Let's Encrypt certificate by itself.
SERVER_NAME=boutique.example.fr
# Optional: contact address for Let's Encrypt.
# CADDY_GLOBAL_OPTIONS="email admin@example.fr"
# Optional: host ports (defaults: 80 and 443).
# HTTP_PORT=80
# HTTPS_PORT=443
###< Docker / Caddy ###

###> PostgreSQL ###
POSTGRES_DB=app
POSTGRES_USER=app
# Letters and digits only (it is embedded in DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=
###< PostgreSQL ###

###> Symfony ###
# openssl rand -hex 32
APP_SECRET=
# Public URL, used for links in e-mails sent by the worker.
DEFAULT_URI=https://boutique.example.fr
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# Only with SERVER_NAME=:80 behind another reverse proxy: its IP addresses or ranges (comma-separated),
# or PRIVATE_SUBNETS. Leave empty when Caddy faces the Internet itself (default).
TRUSTED_PROXIES=
###< Symfony ###

###> Mailer (Brevo) ###
# API key: Brevo > SMTP & API > API keys.
MAILER_DSN=brevo+api://BREVO_API_KEY@default
# The sender domain must be authenticated in Brevo (SPF, DKIM, DMARC).
MAILER_FROM="Panier Sauvage <bonjour@example.fr>"
###< Mailer (Brevo) ###

###> Map tiles ###
# Maps of the producer directory and shop pages. Default (in .env): the Plan IGN of the
# Géoplateforme (WMTS, free, keyless, no quota, Licence Ouverte Etalab: https://cartes.gouv.fr/cgu/).
# To change provider: an HTTPS URL with {z}/{x}/{y} (its key in the URL if needed) and its attribution.
# OpenStreetMap's own tiles (https://tile.openstreetmap.org/{z}/{x}/{y}.png) are an option for light
# use only (https://operations.osmfoundation.org/policies/tiles/).
# The Content-Security-Policy allows images from the host of MAP_TILE_URL only. Empty: no map.
# MAP_TILE_URL="https://data.geopf.fr/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=GEOGRAPHICALGRIDSYSTEMS.PLANIGNV2&STYLE=normal&TILEMATRIXSET=PM_0_19&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&FORMAT=image/png"
# MAP_TILE_ATTRIBUTION="© IGN – Plan IGN"
# MAP_TILE_ATTRIBUTION_URL="https://www.ign.fr"
###< Map tiles ###

###> Stripe ###
STRIPE_SECRET_KEY=
# Signing secret of the https://<domain>/webhooks/stripe endpoint.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Product of the solidarity plan (pay what you can, prod_…): monthly prices are created on the fly.
STRIPE_PRODUCT_SOLIDARITY=
###< Stripe ###

###> Legal notices ###
# Publisher and host of the platform: legal notice (LCEN), terms, privacy policy, e-mail footers.
# Every value is required except LEGAL_PUBLISHER_SIRET (when the publisher has none yet) and
# LEGAL_HOST_PHONE. The container refuses to start with an empty or placeholder value.
LEGAL_PUBLISHER_NAME=
# "Entrepreneur individuel", or "SAS au capital de 1 000 €, RCS Romans 123 456 789"...
LEGAL_PUBLISHER_FORM=
LEGAL_PUBLISHER_ADDRESS=
# 14 digits.
LEGAL_PUBLISHER_SIRET=
# Required by the LCEN for the publisher (a business line is fine).
LEGAL_PUBLISHER_PHONE=
LEGAL_PUBLICATION_DIRECTOR=
# Contact of the legal pages; receives the shop reports and the shops to review.
LEGAL_CONTACT_EMAIL=
# Your hosting provider (OVHcloud, Scaleway...): name, postal address, phone.
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_PHONE=
# Public repository of the source code that runs (AGPL-3.0).
LEGAL_SOURCE_CODE_URL=
###< Legal notices ###

###> Instance ###
# Optional: a territorial instance (local authority, PAT) of the same code, see docs/INSTANCE.md.
# Leave them out to run Panier Sauvage itself. A renamed instance always shows "propulsé par
# Panier Sauvage" with a link to LEGAL_SOURCE_CODE_URL, which must publish its modified code (AGPL).
# INSTANCE_NAME="Panier Toqué du local"
# Path inside public/ (.svg, .png or .webp), mounted or built into the image.
# INSTANCE_LOGO=images/instance/logo.svg
# sauge (default), riviere, terre, prune or ardoise: a palette checked for AA contrasts.
# INSTANCE_ACCENT=riviere
# Departments and/or INSEE town codes: restricts the directory, town pages and sitemap.
# INSTANCE_TERRITORY="26362 26281 26057"
# INSTANCE_TERRITORY_NAME="Valence Romans Agglo"
# The directory opens on the producers around this point (latitude,longitude), within 10, 30 or 50 km.
# INSTANCE_TERRITORY_CENTER="44.9334,4.8924"
# INSTANCE_TERRITORY_RADIUS_KM=30
# INSTANCE_WELCOME_TEXT="Les producteurs de l'agglo prennent leurs précommandes ici."
# INSTANCE_CARRIER_NAME="Valence Romans Agglo"
# INSTANCE_CARRIER_URL=https://www.valenceromansagglo.fr
# standard (each producer subscribes with Stripe) or sponsored (the carrier pays for every producer:
# no trial, no Stripe, the STRIPE_* values may stay empty; INSTANCE_CARRIER_NAME required).
# INSTANCE_PRICING=standard
###< Instance ###
