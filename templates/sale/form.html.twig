{% extends 'layout/pro.html.twig' %}

{% set content_width = 'max-w-3xl' %}

{% block title %}{{ sale ? 'Modifier la vente' : 'Nouvelle vente' }}{% endblock %}
{% block page_title %}{{ sale ? 'Modifier la vente' : 'Nouvelle vente' }}{% endblock %}
{% block page_subtitle %}
    {%- if sale -%}
        {{ sale.title }} · livraison {{ sale.deliveryDate|date_long }}
    {%- else -%}
        Une vente ponctuelle. Pour une vente qui revient chaque semaine, crée plutôt une <a class="link" href="{{ path('pro_schedule_index') }}">récurrence</a>.
    {%- endif -%}
{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'flex flex-col gap-5'}}) }}
        {% if form.vars.errors|length > 0 %}
            <div data-form-errors>{{ form_errors(form) }}</div>
        {% endif %}

        <twig:Card>
            <twig:Card:Header><twig:Card:Title>La vente</twig:Card:Title></twig:Card:Header>
            <twig:Card:Content>
                {{ form_row(form.title) }}
                <div class="grid gap-x-4 sm:grid-cols-2">
                    {{ form_row(form.opensAt) }}
                    {{ form_row(form.deadlineAt) }}
                </div>
                {{ form_row(form.deliveryDate, {row_attr: {class: 'sm:max-w-64'}}) }}
                {% if sale and sale.closed %}
                    <p class="text-sm text-ink-soft">Les commandes sont closes : les dates ne changent plus.</p>
                {% elseif sale and not sale.scheduled %}
                    <p class="text-sm text-ink-soft">La vente est déjà ouverte : sa date d'ouverture ne change plus.</p>
                {% endif %}
            </twig:Card:Content>
        </twig:Card>

        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title>Livraisons</twig:Card:Title>
                <twig:Card:Description>Coche les points où tu livres et indique le créneau.</twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content>
                {% if form.deliveries|length == 0 %}
                    {% do form.deliveries.setRendered %}
                    <twig:Empty class="border border-line py-8">
                        <twig:Empty:Header>
                            <twig:Empty:Title>Aucun point de livraison</twig:Empty:Title>
                            <twig:Empty:Description>Ajoute d'abord un point de rendez-vous, un arrêt de tournée ou la livraison à domicile.</twig:Empty:Description>
                        </twig:Empty:Header>
                        <twig:Empty:Content>
                            <twig:Button as="a" href="{{ safe_path('pro_delivery_point_index', '/pro/points-de-livraison') }}" variant="secondary">Gérer mes points de livraison</twig:Button>
                        </twig:Empty:Content>
                    </twig:Empty>
                {% else %}
                    <ul class="divide-y divide-line-soft">
                        {% for row in form.deliveries %}
                            {% set delivery_row = row.vars.data %}
                            <li class="flex flex-col gap-2 py-3 first:pt-0 last:pb-0 sm:flex-row sm:items-center sm:gap-4" data-delivery-row>
                                <div class="flex min-h-11 min-w-0 flex-1 items-center gap-3">
                                    {{ form_widget(row.selected) }}
                                    <label for="{{ row.selected.vars.id }}" class="min-w-0">
                                        <span class="block truncate font-medium text-ink">{{ delivery_row.point.name }}</span>
                                        <span class="block text-sm text-ink-soft">
                                            {{ delivery_row.point.type.label }}
                                            {%- if delivery_row.ordered %} · déjà choisi par des clients{% endif %}
                                            {%- if delivery_row.timesLocked %} · horaires figés : des clients ont commandé sur ce créneau{% endif %}
                                        </span>
                                    </label>
                                </div>
                                <div class="flex items-center gap-2 ps-8 sm:ps-0">
                                    <label for="{{ row.startTime.vars.id }}" class="text-sm text-ink-soft">de</label>
                                    {{ form_widget(row.startTime, {attr: {class: 'w-28'}}) }}
                                    <label for="{{ row.endTime.vars.id }}" class="text-sm text-ink-soft">à</label>
                                    {{ form_widget(row.endTime, {attr: {class: 'w-28'}}) }}
                                </div>
                                {% if not row.vars.valid %}
                                    <div class="w-full sm:order-last">
                                        {{ form_errors(row.selected) }}
                                        {{ form_errors(row.startTime) }}
                                        {{ form_errors(row.endTime) }}
                                        {{ form_errors(row) }}
                                    </div>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    <div class="mt-3">{{ form_errors(form.deliveries) }}</div>
                {% endif %}
            </twig:Card:Content>
        </twig:Card>

        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title>Produits proposés</twig:Card:Title>
                <twig:Card:Description>Prix TTC et quantité maximale pour cette vente. Laisse la quantité vide si elle est illimitée.</twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content>
                {% if form.offers|length == 0 %}
                    {% do form.offers.setRendered %}
                    <twig:Empty class="border border-line py-8">
                        <twig:Empty:Header>
                            <twig:Empty:Title>Aucun produit</twig:Empty:Title>
                            <twig:Empty:Description>Ajoute d'abord tes produits : ils seront proposés ici.</twig:Empty:Description>
                        </twig:Empty:Header>
                        <twig:Empty:Content>
                            <twig:Button as="a" href="{{ safe_path('pro_product_index', '/pro/produits') }}" variant="secondary">Gérer mes produits</twig:Button>
                        </twig:Empty:Content>
                    </twig:Empty>
                {% else %}
                    <ul class="divide-y divide-line-soft">
                        {% for row in form.offers %}
                            {% set offer_row = row.vars.data %}
                            <li class="flex flex-col gap-2 py-3 first:pt-0 last:pb-0 sm:flex-row sm:items-center sm:gap-4" data-offer-row>
                                <div class="flex min-h-11 min-w-0 flex-1 items-center gap-3">
                                    {{ form_widget(row.selected) }}
                                    <label for="{{ row.selected.vars.id }}" class="min-w-0">
                                        <span class="flex items-center gap-2">
                                            <span class="truncate font-medium text-ink">{{ offer_row.product.name }}</span>
                                            {% if offer_row.product.seasonal %}<twig:Badge>Du moment</twig:Badge>{% endif %}
                                            {% if offer_row.product.archived %}<twig:Badge variant="muted">Archivé</twig:Badge>{% endif %}
                                        </span>
                                        {% if offer_row.reservedQty > 0 %}
                                            <span class="block text-sm text-ink-soft">{{ offer_row.reservedQty|quantity(offer_row.product.unit) }} déjà réservé{{ offer_row.reservedQty > 1000 ? 's' }}</span>
                                        {% endif %}
                                    </label>
                                </div>
                                <div class="flex items-end gap-3 ps-8 sm:ps-0">
                                    <div class="flex flex-col gap-1">
                                        <label for="{{ row.priceCents.vars.id }}" class="text-xs font-medium text-ink-soft">Prix</label>
                                        <div class="flex items-center gap-1.5 [&_input]:w-24 [&_input]:text-end">{{ form_widget(row.priceCents) }}</div>
                                    </div>
                                    <div class="flex flex-col gap-1">
                                        <label for="{{ row.maxQty.vars.id }}" class="text-xs font-medium text-ink-soft">Quantité max.{% if offer_row.product.unit.weighed %} (kg){% endif %}</label>
                                        {{ form_widget(row.maxQty, {attr: {class: 'w-28'}}) }}
                                    </div>
                                </div>
                                {% if not row.vars.valid %}
                                    <div class="w-full sm:order-last">
                                        {{ form_errors(row.selected) }}
                                        {{ form_errors(row.priceCents) }}
                                        {{ form_errors(row.maxQty) }}
                                        {{ form_errors(row) }}
                                    </div>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    <div class="mt-3">{{ form_errors(form.offers) }}</div>
                {% endif %}
            </twig:Card:Content>
        </twig:Card>

        <twig:Card>
            <twig:Card:Header><twig:Card:Title>Modifications par tes clients</twig:Card:Title></twig:Card:Header>
            <twig:Card:Content>
                {{ form_row(form.allowCustomerEdit) }}
                {{ form_row(form.editCutoffHours, {row_attr: {class: 'sm:max-w-md'}}) }}
                <p class="text-sm text-ink-soft">Après la date limite, c'est toi qui ajoutes, modifies ou retires les commandes.</p>
            </twig:Card:Content>
        </twig:Card>

        <div class="flex flex-wrap items-center gap-3">
            <twig:Button type="submit">{{ sale ? 'Enregistrer' : 'Créer la vente' }}</twig:Button>
            <twig:Button as="a" href="{{ sale ? path('pro_sale_show', {id: sale.id}) : path('pro_sale_index') }}" variant="ghost">Retour</twig:Button>
        </div>
    {{ form_end(form) }}
{% endblock %}
