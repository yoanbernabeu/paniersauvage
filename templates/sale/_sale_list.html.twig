{#
    Dense list of sales. Variables: sales, order_counts (sale id => number of orders).
#}
<ul class="divide-y divide-line-soft overflow-hidden rounded-xl bg-white shadow-card ring-1 ring-line">
    {% for sale in sales %}
        {% set order_count = order_counts[sale.id] ?? 0 %}
        <li>
            <a href="{{ path('pro_sale_show', {id: sale.id}) }}" class="flex min-h-14 items-center gap-3 px-4 py-3 transition-colors hover:bg-sage-soft/70">
                <div class="min-w-0 flex-1">
                    <p class="truncate font-medium text-ink">{{ sale.title }}</p>
                    <p class="text-sm text-ink-soft">
                        Livraison {{ sale.deliveryDate|date_long }}
                        {%- if sale.isOpen() %} · commandes jusqu'au {{ sale.deadlineAt|datetime_long }}
                        {%- elseif sale.scheduled %} · ouvre le {{ sale.opensAt|datetime_long }}
                        {%- endif %}
                    </p>
                    <p class="mt-1 flex flex-wrap items-center gap-2 sm:hidden">
                        {{ include('sale/_status_badge.html.twig') }}
                        <span class="amount text-sm text-ink-soft">{{ order_count }} commande{{ order_count > 1 ? 's' }}</span>
                    </p>
                </div>
                <span class="amount hidden text-sm text-ink-soft sm:inline">{{ order_count }} commande{{ order_count > 1 ? 's' }}</span>
                <span class="hidden sm:inline-flex">{{ include('sale/_status_badge.html.twig') }}</span>
                <twig:ux:icon name="lucide:chevron-right" class="size-4 shrink-0 text-ink-soft" />
            </a>
        </li>
    {% endfor %}
</ul>
