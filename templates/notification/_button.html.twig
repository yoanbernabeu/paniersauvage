{# Main action: wheat pill with dark text. Variables: url, label. #}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 20px 0;">
    <tr>
        <td align="center" bgcolor="#E8B931" style="background-color:#E8B931;border-radius:999px;">
            <a href="{{ url }}" style="display:inline-block;padding:13px 26px;{{ font_text }}font-size:16px;line-height:20px;font-weight:600;color:#1F2A24;text-decoration:none;border-radius:999px;">{{ label }}</a>
        </td>
    </tr>
</table>
