{% extends 'layout/customer.html.twig' %}

{% block title %}Commander chez {{ shop.name }}{% endblock %}
{% block meta_description %}Commande en ligne chez {{ shop.name }} : livraison {{ sale.deliveryDate|date_long }}.{% endblock %}

{# The fixed order bar replaces the footer on this screen. #}
{% block footer %}{% endblock %}

{% block content %}
    {{ include('ordering/_shop_header.html.twig') }}

    <section class="mb-8 rounded-xl bg-sage-soft p-5" data-sale-banner>
        {% if sale.isLastMinute() %}
            <twig:Badge variant="default" data-last-minute>Dernière minute 🧺</twig:Badge>
        {% else %}
            <twig:Badge variant="sage">Commandes ouvertes</twig:Badge>
        {% endif %}
        <h1 class="mt-3 text-3xl leading-tight font-semibold text-ink">Livraison {{ sale.deliveryDate|date_long }}</h1>
        <p class="mt-2 text-base text-sage-deep">
            {% if sale.isLastMinute() %}
                Il reste quelques produits : commande jusqu'au {{ sale.orderDeadline|datetime_long }}, dans la limite des quantités affichées.
                Une fois validée, contacte ton producteur pour la changer.
            {% else %}
                Commande jusqu'au {{ sale.deadlineAt|datetime_long }}.
                {% if not sale.allowCustomerEdit %}
                    Une fois validée, contacte ton producteur pour la changer.
                {% elseif sale.effectiveEditCutoffAt == sale.deadlineAt %}
                    Tu pourras modifier jusque-là.
                {% else %}
                    Tu pourras modifier jusqu'au {{ sale.effectiveEditCutoffAt|datetime_long }}.
                {% endif %}
            {% endif %}
        </p>
        {% if shop.paymentSummary %}
            <p class="mt-2 flex items-start gap-2 text-sm text-sage-deep" data-payment-info>
                <twig:ux:icon name="lucide:wallet" class="mt-0.5 size-4 shrink-0" />
                <span>Tu règles directement au producteur : {{ shop.paymentSummary }}</span>
            </p>
        {% endif %}
    </section>

    {{ include('ordering/_new_customer_notice.html.twig', {customer: customer, with_cap: true, class: 'mb-8'}) }}

    {% if previous_order %}
        <div class="mb-8 flex flex-col gap-3 rounded-xl border border-line bg-white p-4 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm text-ink-soft">Comme la dernière fois ? On remet les mêmes produits dans ton panier, s'ils sont disponibles.</p>
            <twig:Button as="a" variant="secondary" href="{{ path('sale_show', {slug: shop.slug, code: sale.code, reprendre: 1, via: via|default(null)}) }}" data-resume-order>
                <twig:ux:icon name="lucide:repeat" />
                Reprendre ma commande précédente
            </twig:Button>
        </div>
    {% endif %}

    {{ include('recurring/_sale_plan.html.twig', {sale: sale, shop: shop}, ignore_missing = true) }}

    {{ form_start(form, {attr: {'data-controller': 'order-form'}}) }}
        {{ include('ordering/_form_fields.html.twig') }}

        <section aria-labelledby="titre-coordonnees" class="mb-6">
            <h2 id="titre-coordonnees" class="font-display mb-1 text-2xl font-semibold text-ink">Tes coordonnées</h2>
            {% if customer %}
                <p class="mb-4 text-sm text-ink-soft">Tu commandes avec <strong class="font-semibold text-ink">{{ customer.email }}</strong>.</p>
            {% else %}
                <p class="mb-4 text-sm text-ink-soft">
                    On t'envoie la confirmation par e-mail. Déjà commandé ici ?
                    <a href="{{ safe_path('customer_login', '/connexion') }}" class="link">Connecte-toi</a> pour retrouver tes commandes.
                </p>
                {{ form_row(form.email) }}
            {% endif %}
            <div class="grid gap-x-4 sm:grid-cols-2">
                {{ form_row(form.firstName) }}
                {{ form_row(form.lastName) }}
            </div>
            {{ form_row(form.phone) }}
        </section>

        {% if form.website is defined %}
            {# Honeypot: off screen and out of the tab order, only bots fill it in. #}
            <div class="absolute -left-[10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
                {{ form_label(form.website) }}
                {{ form_widget(form.website) }}
            </div>
        {% endif %}

        {{ include('legal/_sale_information.html.twig') }}
        {# Where the customer came from (?via=…), kept without a cookie (App\Ordering\Enum\OrderSource). #}
        {% if via|default(null) %}<input type="hidden" name="via" value="{{ via }}" data-order-via>{% endif %}

        {{ form_rest(form) }}
        {{ include('ordering/_submit_bar.html.twig', {submit_label: 'Valider ma commande'}) }}
    {{ form_end(form, {render_rest: false}) }}
{% endblock %}
