parameters:
    level: max
    # In the project, not in the shared system temp dir: git worktrees must not share caches.
    tmpDir: var/cache/phpstan
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        # Generated by Symfony (config shapes): huge and not ours.
        - config/reference.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
