{# Order lines, amount due on delivery and accepted means of payment. Variables: order, shop. #}
<h2 style="{{ h2_css }}">Ta commande {{ order.reference }}</h2>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px 0;">
    {% for line in order.lines %}
        <tr>
            <td style="padding:8px 0;border-bottom:1px solid #ECE8DE;{{ font_text }}font-size:16px;line-height:22px;color:#1F2A24;">{{ line.quantity|line_quantity(line.unit) }} {{ line.label }}{% if line.actualQuantity is not null %} · pesé {{ line.actualQuantity|quantity(line.unit) }}{% endif %}</td>
            <td align="right" style="padding:8px 0 8px 12px;border-bottom:1px solid #ECE8DE;{{ font_text }}font-size:16px;line-height:22px;color:#1F2A24;white-space:nowrap;">{{ line.estimated ? 'environ ' }}{{ line.totalCents|money }}</td>
        </tr>
    {% endfor %}
    <tr>
        <td style="padding:12px 0 0 0;{{ font_text }}font-size:16px;line-height:22px;font-weight:600;color:#2F4337;">À régler à la livraison</td>
        <td align="right" style="padding:12px 0 0 12px;{{ font_text }}font-size:18px;line-height:22px;font-weight:600;color:#2F4337;white-space:nowrap;">{{ order.estimated ? 'environ ' }}{{ order.totalCents|money }}</td>
    </tr>
</table>
{% if order.vatExempt %}
    <p style="{{ muted_css }}">{{ constant('App\\Shop\\Enum\\VatRegime::FRANCHISE_MENTION') }}</p>
{% endif %}
{% if order.estimated %}
    <p style="{{ muted_css }}">Produits au poids : le montant exact est calculé à la pesée, à la livraison.</p>
{% endif %}
{% if shop.paymentSummary %}
    <p style="{{ muted_css }}">Moyens de paiement acceptés par {{ shop.name }} : {{ shop.paymentSummary }}</p>
{% endif %}
{% if order.note %}
    <p style="{{ muted_css }}">Ta note : {{ order.note }}</p>
{% endif %}
