{%- props
    ## 'default'|'sm' The select size.
    size = 'default'
-%}
<div
    data-slot="native-select-wrapper"
    data-size="{{ size }}"
    class="{{ ('group/native-select relative w-full has-[select:disabled]:opacity-50 ' ~ attributes.render('class'))|tailwind_merge }}"
>
    <select
        data-slot="native-select"
        data-size="{{ size }}"
        class="h-11 w-full min-w-0 appearance-none rounded-lg border border-input bg-white py-2 ps-3.5 pe-9 text-base text-ink transition-colors outline-none select-none selection:bg-primary selection:text-primary-foreground placeholder:text-muted-foreground focus-visible:border-ring disabled:pointer-events-none disabled:cursor-not-allowed aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 data-[size=sm]:h-9 data-[size=sm]:text-sm data-[size=sm]:rounded-[min(var(--radius-md),10px)] data-[size=sm]:py-0.5 dark:bg-input/30 dark:hover:bg-input/50 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 dark:[color-scheme:dark]"
        {{ attributes.without('class') }}
    >
        {##- The select options, typically `NativeSelect:Option` and `NativeSelect:OptGroup` components. -#}
        {%- block content %}{% endblock -%}
    </select>
    <twig:ux:icon name="lucide:chevron-down" class="pointer-events-none absolute top-1/2 end-3 size-4 -translate-y-1/2 text-muted-foreground select-none" aria-hidden="true" data-slot="native-select-icon" />
</div>
