{#
    One order of the signed-in customer, as a tappable card.
    Variables: order (App\Ordering\Entity\Order), upcoming (bool).
#}
{% set sale = order.sale %}
{% set delivery = order.saleDelivery %}
<li>
    <a href="{{ safe_path('customer_order_show', '/mes-commandes/' ~ order.reference, {reference: order.reference}) }}"
       class="group flex items-center gap-4 rounded-xl bg-white p-4 shadow-card ring-1 ring-line transition-colors hover:ring-sage sm:p-5"
       data-order="{{ order.reference }}">
        <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <p class="font-display text-lg leading-snug font-semibold text-ink">{{ order.shop.name }}</p>
                {{ include('ordering/_order_status_badge.html.twig') }}
            </div>
            <p class="mt-1.5 flex items-start gap-2 text-sm text-ink">
                <twig:ux:icon name="lucide:calendar" class="mt-0.5 size-4 shrink-0 text-sage-dark" />
                <span>
                    {% if upcoming %}Livraison {% endif %}{{ sale.deliveryDate|date_long(not upcoming) }}{% if upcoming %}, {{ time_range(delivery.startsAt, delivery.endsAt) }}{% endif %}
                </span>
            </p>
            {% if upcoming %}
                <p class="mt-1 flex items-start gap-2 text-sm text-ink-soft">
                    <twig:ux:icon name="lucide:{{ delivery.deliveryPoint.type.icon }}" class="mt-0.5 size-4 shrink-0 text-sage-dark" />
                    <span>{{ delivery.deliveryPoint.name }}</span>
                </p>
            {% endif %}
            <p class="mt-2 text-sm text-ink-soft">
                <span class="amount font-semibold text-ink">{{ order.estimated ? 'environ ' }}{{ order.totalCents|money }}</span>
                · commande {{ order.reference }}
            </p>
        </div>
        <twig:ux:icon name="lucide:chevron-right" class="size-5 shrink-0 text-ink-soft group-hover:text-sage-dark" />
    </a>
</li>
