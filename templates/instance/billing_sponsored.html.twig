{#
    The subscription page of a sponsored instance (INSTANCE_PRICING=sponsored, docs/INSTANCE.md):
    the carrier pays for every producer, there is no trial, no plan and no Stripe.
#}
{% extends 'layout/pro.html.twig' %}

{% set content_width = 'max-w-3xl' %}

{% block title %}Abonnement{% endblock %}
{% block page_title %}Abonnement{% endblock %}
{% block page_subtitle %}{{ instance.sponsorshipMention() }}.{% endblock %}

{% block content %}
    <section aria-labelledby="statut" class="rounded-2xl border border-line bg-white p-4 sm:p-5" data-billing-status="sponsored">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 id="statut" class="text-base font-semibold text-ink">Où tu en es</h2>
            <twig:Badge variant="secondary">Offert</twig:Badge>
        </div>
        <p class="mt-3 text-base text-ink" data-billing-summary>
            Ton abonnement à {{ instance.name }} est offert par
            <strong class="font-semibold">{{ instance.carrierName }}</strong>{% if instance.territory.name %}, pour les producteurs de {{ instance.territory.name }}{% endif %}.
            Tu n'as rien à payer et aucune carte à donner : ventes, clients et commandes sans limite.
        </p>
        <p class="mt-2 text-sm text-ink-soft">
            Comme partout, tes clients te règlent directement : aucune commission, aucun paiement ne passe par l'outil.
            {% if instance.carrierUrl %}<a href="{{ instance.carrierUrl }}" class="link" rel="noopener">En savoir plus sur {{ instance.carrierName }}</a>.{% endif %}
        </p>
    </section>
{% endblock %}
