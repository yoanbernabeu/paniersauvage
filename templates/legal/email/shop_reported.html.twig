{% extends 'notification/layout.html.twig' %}

{% block preheader %}{{ report.reason.label }} : {{ shop.name }}.{% endblock %}

{% block content %}
    <p style="{{ p_css }}">Nouveau signalement de la boutique <a href="{{ shop_url }}" style="{{ link_css }}">{{ shop.name }}</a>, le {{ report.reportedAt|datetime_long }}.</p>
    <p style="{{ p_css }}"><strong>Motif :</strong> {{ report.reason.label }}</p>
    <p style="{{ box_css }}{{ font_text }}font-size:15px;line-height:22px;color:#1F2A24;white-space:pre-line;" data-report-message>{{ report.message }}</p>
    <p style="{{ muted_css }}margin-top:16px;">
        {% if report.reporterEmail %}
            Réponds à cet e-mail pour écrire à la personne qui a signalé ({{ report.reporterEmail }}).
        {% else %}
            La personne n'a pas laissé d'e-mail.
        {% endif %}
        SIRET de la boutique : {{ shop.siret ?? 'non renseigné' }}.
    </p>
{% endblock %}
