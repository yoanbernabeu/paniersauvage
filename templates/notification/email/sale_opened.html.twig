{% extends 'notification/layout.html.twig' %}

{% block preheader %}Tu as jusqu'au {{ sale.deadlineAt|datetime_long }} pour commander.{% endblock %}

{% block title %}Les commandes sont ouvertes 🌾{% endblock %}

{% block content %}
    <p style="{{ p_css }}">Bonjour{% if customer.firstName %} {{ customer.firstName }}{% endif %},</p>
    <p style="{{ p_css }}">{{ shop.name }} prend les commandes pour la livraison du <strong style="font-weight:600;">{{ sale.deliveryDate|date_long }}</strong>.</p>
    <p style="{{ p_css }}">Tu as jusqu'au <strong style="font-weight:600;">{{ sale.deadlineAt|datetime_long }}</strong> pour commander.</p>

    {{ include('notification/_button.html.twig', {url: sale_url, label: 'Je commande'}) }}

    {% if sale.offers is not empty %}
        <h2 style="{{ h2_css }}">Au programme</h2>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px 0;">
            {% for offer in sale.offers %}
                <tr>
                    <td style="padding:8px 0;border-bottom:1px solid #ECE8DE;{{ font_text }}font-size:16px;line-height:22px;color:#1F2A24;">{{ offer.product.name }}</td>
                    <td align="right" style="padding:8px 0 8px 12px;border-bottom:1px solid #ECE8DE;{{ font_text }}font-size:16px;line-height:22px;color:#1F2A24;white-space:nowrap;">{{ offer.priceCents|money }} / {{ offer.product.unit.short }}</td>
                </tr>
            {% endfor %}
        </table>
    {% endif %}

    {% if sale.deliveries is not empty %}
        <h2 style="{{ h2_css }}">Où et quand</h2>
        {% for delivery in sale.deliveries %}
            {{ include('notification/_delivery.html.twig') }}
        {% endfor %}
    {% endif %}
{% endblock %}

{% block footer %}{{ include('notification/_customer_footer.html.twig', {following: true}) }}{% endblock %}
