{#
    Producer directory search form. Variables: criteria, radii, categories (list of ShopCategory).
    GET on the directory page: the URL can be shared. The filters only narrow the list down, the
    order stays the distance.
#}
{% set filters = criteria.filters %}
<form method="get" action="{{ path('producer_directory') }}#resultats" role="search" aria-label="Chercher des producteurs"
      class="{{ form_class|default('mt-6') }} rounded-xl bg-white p-4 shadow-card ring-1 ring-line sm:p-5"
      data-controller="geolocate" data-search-form>
    <label for="ou" class="text-sm font-semibold text-ink">Ta ville ou ton code postal</label>
    <div class="relative mt-1.5">
        <twig:ux:icon name="lucide:map-pin" class="pointer-events-none absolute top-1/2 left-3.5 size-5 -translate-y-1/2 text-sage-dark" aria-hidden="true" />
        <twig:Input type="search" id="ou" name="ou" value="{{ criteria.place }}" placeholder="Valence, 26400…"
                    autocomplete="address-level2" enterkeyhint="search" maxlength="100" class="ps-11"
                    data-geolocate-target="place" data-action="input->geolocate#forgetPosition" />
    </div>
    {# Kept from a search by position, so that changing the radius keeps it; typing a place drops it. #}
    <input type="hidden" name="lat" value="{{ criteria.hasPosition() ? criteria.latitude : '' }}" data-geolocate-target="latitude" {{ criteria.hasPosition() ? '' : 'disabled' }}>
    <input type="hidden" name="lng" value="{{ criteria.hasPosition() ? criteria.longitude : '' }}" data-geolocate-target="longitude" {{ criteria.hasPosition() ? '' : 'disabled' }}>

    <div class="mt-3 flex flex-wrap items-end gap-3">
        <div class="min-w-28 flex-1 sm:flex-none">
            <label for="rayon" class="text-sm font-semibold text-ink">Rayon</label>
            <twig:NativeSelect id="rayon" name="rayon" class="mt-1.5">
                {% for radius in radii %}
                    <twig:NativeSelect:Option value="{{ radius }}" :selected="radius == criteria.radiusKm">{{ radius }} km</twig:NativeSelect:Option>
                {% endfor %}
            </twig:NativeSelect>
        </div>
        <twig:Button type="submit" class="flex-1 sm:flex-none">
            <twig:ux:icon name="lucide:search" />
            Chercher
        </twig:Button>
        <twig:Button type="button" variant="secondary" class="w-full sm:w-auto" hidden data-geolocate-target="button" data-action="geolocate#locate">
            <twig:ux:icon name="lucide:locate-fixed" />
            Autour de moi
        </twig:Button>
    </div>
    <p class="mt-3 text-sm text-sage-deep" role="status" aria-live="polite" hidden data-geolocate-target="status"></p>

    <details class="group mt-4 border-t border-line-soft pt-3" {{ filters.isEmpty() ? '' : 'open' }} data-search-filters>
        <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-lg text-sm font-semibold text-sage-dark [&::-webkit-details-marker]:hidden">
            <twig:ux:icon name="lucide:sliders-horizontal" class="size-4" />
            Affiner
            {% if not filters.isEmpty() %}<span class="rounded-full bg-sage-mist px-2 py-0.5 text-xs text-sage-deep">{{ filters.toQuery()|length }} filtre{{ filters.toQuery()|length > 1 ? 's' }}</span>{% endif %}
            <twig:ux:icon name="lucide:chevron-down" class="ms-auto size-4 transition-transform group-open:rotate-180" />
        </summary>
        <div class="mt-2 grid gap-4 sm:grid-cols-2">
            <div>
                <label for="categorie" class="text-sm font-semibold text-ink">Ce qu'il vend</label>
                <twig:NativeSelect id="categorie" name="categorie" class="mt-1.5">
                    <twig:NativeSelect:Option value="" :selected="filters.category is null">Tout</twig:NativeSelect:Option>
                    {% for category in categories %}
                        <twig:NativeSelect:Option value="{{ category.value }}" :selected="filters.category == category">{{ category.label }}</twig:NativeSelect:Option>
                    {% endfor %}
                </twig:NativeSelect>
            </div>
            <fieldset>
                <legend class="text-sm font-semibold text-ink">Seulement les producteurs qui…</legend>
                <label class="mt-1 flex min-h-11 cursor-pointer items-center gap-3 text-sm text-ink">
                    <twig:Checkbox name="bio" value="1" :checked="filters.organic" />
                    ont des produits bio
                </label>
                <label class="flex min-h-11 cursor-pointer items-center gap-3 text-sm text-ink">
                    <twig:Checkbox name="cheques-alimentaires" value="1" :checked="filters.foodVouchers" />
                    acceptent les chèques ou la caisse alimentaire
                </label>
                <label class="flex min-h-11 cursor-pointer items-center gap-3 text-sm text-ink">
                    <twig:Checkbox name="monnaie-locale" value="1" :checked="filters.localCurrency" />
                    acceptent une monnaie locale
                </label>
            </fieldset>
        </div>
    </details>
</form>
