/*
 * Service worker of the delivery sheet (SPEC §20, lot F), served by pro_delivery_sheet_worker.
 *
 * It answers for two kinds of requests only, everything else goes to the network untouched:
 * - the delivery sheets (/pro/ventes/<id>/livraison): network first, with the last copy as a
 *   fallback when the network fails or takes more than a few seconds;
 * - the assets loaded by a sheet (/assets/…, versioned by AssetMapper): from the cache once kept.
 *
 * The copies hold customers' names and phone numbers: at most 10 sheets, none older than 7 days,
 * and all of them are deleted when the producer signs out.
 */
const CACHE = 'panier-sauvage-feuille-v1';
const SHEET = /^\/pro\/ventes\/\d+\/livraison$/;
const LOGOUT = '{{ path('pro_logout') }}';
const MAX_SHEETS = 10;
const MAX_ASSETS = 150;
const MAX_AGE = 7 * 24 * 3600 * 1000;
const NETWORK_TIMEOUT = 4000;

const sameOrigin = (url) => url.origin === self.location.origin;
const isSheet = (url) => sameOrigin(url) && SHEET.test(url.pathname);
const isAsset = (url) => sameOrigin(url) && url.pathname.startsWith('/assets/');
const keep = (response) => response.ok && 'basic' === response.type && !response.redirected;

self.addEventListener('install', () => self.skipWaiting());

self.addEventListener('activate', (event) => {
    event.waitUntil((async () => {
        const names = await caches.keys();
        await Promise.all(names.filter((name) => name.startsWith('panier-sauvage-feuille-') && name !== CACHE).map((name) => caches.delete(name)));
        await self.clients.claim();
    })());
});

// The sheet sends the URLs it loaded before the worker was there.
self.addEventListener('message', (event) => {
    const data = event.data || {};
    if ('cache-sheet' === data.type && Array.isArray(data.urls)) {
        event.waitUntil(remember(data.urls));
    }
});

self.addEventListener('fetch', (event) => {
    const request = event.request;
    const url = new URL(request.url);
    if (!sameOrigin(url)) {
        return;
    }

    if ('POST' === request.method && url.pathname === LOGOUT) {
        event.waitUntil(caches.delete(CACHE));
        return;
    }
    if ('GET' !== request.method) {
        return;
    }

    if (isSheet(url) && ('navigate' === request.mode || (request.headers.get('Accept') || '').includes('text/html'))) {
        event.respondWith(sheet(event, request));
    } else if (isAsset(url)) {
        event.respondWith(asset(event, request));
    }
});

async function sheet(event, request) {
    const cache = await caches.open(CACHE);
    const network = fetch(request).then(async (response) => {
        if (keep(response)) {
            await cache.put(request.url, response.clone());
            await prune(cache);
        }

        return response;
    });
    event.waitUntil(network.then(() => undefined, () => undefined));

    const cached = await cache.match(request.url);
    if (!cached) {
        try {
            return await network;
        } catch {
            return offline();
        }
    }

    const late = new Promise((resolve) => { setTimeout(() => resolve(null), NETWORK_TIMEOUT); });
    try {
        return (await Promise.race([network, late])) || cached;
    } catch {
        return cached;
    }
}

async function asset(event, request) {
    const cache = await caches.open(CACHE);
    const cached = await cache.match(request.url);
    if (cached) {
        return cached;
    }

    const response = await fetch(request);
    if (keep(response)) {
        const client = event.clientId ? await self.clients.get(event.clientId) : null;
        if (client && isSheet(new URL(client.url))) {
            event.waitUntil(cache.put(request.url, response.clone()).then(() => prune(cache)));
        }
    }

    return response;
}

async function remember(urls) {
    const cache = await caches.open(CACHE);
    await Promise.all(urls.map(async (raw) => {
        let url;
        try {
            url = new URL(raw, self.location.origin);
        } catch {
            return;
        }
        if (!isSheet(url) && !isAsset(url)) {
            return;
        }
        if (isAsset(url) && await cache.match(url.href)) {
            return;
        }
        try {
            const response = await fetch(url.href, { credentials: 'same-origin' });
            if (keep(response)) {
                await cache.put(url.href, response);
            }
        } catch {
            // Offline: kept next time.
        }
    }));
    await prune(cache);
}

/** Drops the sheets older than 7 days, then the oldest ones beyond 10, and the oldest assets beyond 150. */
async function prune(cache) {
    const sheets = [];
    const assets = [];
    for (const request of await cache.keys()) {
        if (!isSheet(new URL(request.url))) {
            assets.push(request);
            continue;
        }
        const response = await cache.match(request);
        const date = Date.parse(response?.headers.get('Date') || '') || 0;
        if (Date.now() - date > MAX_AGE) {
            await cache.delete(request);
        } else {
            sheets.push({ request, date });
        }
    }
    sheets.sort((a, b) => b.date - a.date);
    await Promise.all(sheets.slice(MAX_SHEETS).map(({ request }) => cache.delete(request)));
    await Promise.all(assets.slice(0, Math.max(0, assets.length - MAX_ASSETS)).map((request) => cache.delete(request)));
}

function offline() {
    const body = '<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Hors ligne · Panier Sauvage</title></head>'
        + '<body><h1>Pas de réseau</h1><p>Cette feuille de livraison n\'a pas encore été ouverte sur ce téléphone : elle n\'est pas disponible hors ligne.</p>'
        + '<p>Réessaie dès que tu captes, ou utilise la feuille de livraison en PDF.</p></body></html>';

    return new Response(body, { status: 503, headers: { 'Content-Type': 'text/html; charset=UTF-8', 'Content-Security-Policy': "default-src 'none'" } });
}
