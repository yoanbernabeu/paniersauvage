{% extends 'layout/customer.html.twig' %}

{% block title %}Ne plus recevoir les annonces de {{ shop.name }}{% endblock %}

{% set content_width = 'max-w-xl' %}

{% block content %}
    <h1 class="text-3xl leading-tight font-semibold text-ink">Ne plus recevoir les annonces de {{ shop.name }} ?</h1>

    {% if already_off %}
        <p class="mt-3 leading-relaxed text-ink-soft" data-unsubscribe-already-off>
            C'est déjà le cas : tu ne reçois plus d'e-mail quand {{ shop.name }} ouvre une vente.
        </p>
    {% else %}
        <p class="mt-3 leading-relaxed text-ink-soft">
            Tu ne recevras plus d'e-mail quand {{ shop.name }} ouvre une vente. Les e-mails sur tes commandes (confirmation, changement, rappel) continueront d'arriver.
        </p>

        <form method="post" action="{{ action }}" class="mt-6 flex flex-col gap-3 sm:flex-row" data-turbo="false">
            <twig:Button type="submit">Ne plus recevoir ses annonces</twig:Button>
            <twig:Button as="a" href="{{ path('shop_show', {slug: shop.slug}) }}" variant="secondary">Retour à sa page</twig:Button>
        </form>
    {% endif %}
{% endblock %}
