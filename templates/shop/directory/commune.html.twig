{% extends 'layout/customer.html.twig' %}

{#
    Page of a town of the producer directory, indexable (SPEC §11). Variables: commune
    (App\Shop\Search\DirectoryCommune) and those of shop/directory/_results.html.twig.
#}

{% block title %}Producteurs à {{ commune.city }} et alentours{% endblock %}
{% block meta_description %}{{ results|length }} producteur{{ results|length > 1 ? 's' }} près de {{ commune.label }} prennent leurs précommandes avec {{ instance.name }} : pain, légumes, fromages… Commande en ligne, règle directement au producteur.{% endblock %}

{% block head_extra %}
    <link rel="canonical" href="{{ url('producer_directory_commune', {commune: commune.slug}) }}">
{% endblock %}

{% block stylesheets %}
    {% if map %}<link rel="stylesheet" href="{{ asset('vendor/leaflet/dist/leaflet.min.css') }}">{% endif %}
    {{ parent() }}
{% endblock %}

{% block main %}
    <main id="contenu" class="flex-1">
        <section aria-labelledby="commune-titre" class="mx-auto w-full max-w-5xl px-4 pt-6 pb-6 sm:px-6 sm:pt-10">
            <nav aria-label="Fil d'Ariane" class="mb-3 text-sm">
                <a href="{{ path('producer_directory') }}" class="link">Trouver un producteur</a>
                <span aria-hidden="true" class="text-ink-soft"> / </span>
                <span class="text-ink-soft" aria-current="page">{{ commune.city }}</span>
            </nav>
            <h1 id="commune-titre" class="max-w-3xl text-3xl leading-[1.08] font-semibold text-balance text-ink sm:text-4xl">Producteurs à {{ commune.city }} et alentours</h1>
            <p class="mt-3 max-w-2xl text-ink-soft" data-directory-transparency>
                Producteurs qui utilisent {{ instance.name }} et ont choisi d'apparaître ici, classés uniquement par distance. Aucune mise en avant payée.
            </p>
            {{ include('instance/_directory_territory.html.twig') }}
        </section>

        <section id="resultats" aria-labelledby="resultats-titre" class="mx-auto w-full max-w-5xl px-4 pb-10 sm:px-6" data-search-state="results">
            <div class="max-w-3xl lg:has-data-[map=on]:max-w-none">
                {{ include('shop/directory/_results.html.twig') }}
            </div>
        </section>

        <section aria-label="Chercher ailleurs" class="mx-auto w-full max-w-5xl px-4 pb-14 sm:px-6">
            <div class="max-w-3xl">
                <h2 class="font-display text-xl font-semibold text-ink">Chercher ailleurs ou affiner</h2>
                {{ include('shop/directory/_search_form.html.twig', {form_class: 'mt-3'}) }}
            </div>
        </section>
    </main>
{% endblock %}
