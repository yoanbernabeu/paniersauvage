{#
    Fixed bottom bar of the customer order form: item count, total, and THE wheat button.
    Variables: sale, data (OrderFormData), order (or null), submit_label.
    The server computes the first values; the order-form Stimulus controller keeps them up to date.
#}
{% set order = order|default(null) %}
{% set bar_count = data.itemCount(sale) %}
{% set bar_total = data.estimatedTotalCents(sale, order) %}
<div class="h-28" aria-hidden="true"></div>
<div class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-white/95 pb-[env(safe-area-inset-bottom)] shadow-bar backdrop-blur" data-order-bar>
    <div class="mx-auto flex w-full max-w-3xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
        <p class="min-w-0 leading-tight" aria-live="polite">
            <span class="block text-sm text-ink-soft" data-order-form-target="count">{{ bar_count == 0 ? 'Panier vide' : bar_count ~ ' article' ~ (bar_count > 1 ? 's') }}</span>
            <span class="block font-display text-xl font-semibold text-ink">
                <span class="text-base font-medium text-ink-soft" data-order-form-target="estimate" {% if not data.hasWeighedItems(sale) %}hidden{% endif %}>environ</span>
                <span class="amount" data-order-form-target="total">{{ bar_total|money }}</span>
            </span>
        </p>
        <twig:Button type="submit" size="lg" class="shrink-0 px-5">{{ submit_label }}</twig:Button>
    </div>
</div>
