{% extends 'notification/layout.html.twig' %}

{% block preheader %}Ton lien pour choisir un nouveau mot de passe, valable {{ minutes }} minutes.{% endblock %}

{% block title %}{% if first_name %}Bonjour {{ first_name }},{% else %}Bonjour,{% endif %}{% endblock %}

{% block content %}
    <p style="{{ p_css }}">Tu as demandé à changer le mot de passe de ton espace producteur {{ instance.name }}. Clique sur le bouton pour en choisir un nouveau.</p>
    {{ include('notification/_button.html.twig', {url: url, label: 'Choisir un nouveau mot de passe'}) }}
    <p style="{{ p_css }}{{ box_css }}">Ce lien est valable {{ minutes }} minutes et ne sert qu'une fois.</p>
    <p style="{{ muted_css }}">
        Le bouton ne marche pas ? Copie cette adresse dans ton navigateur :<br>
        <a href="{{ url }}" style="{{ link_css }}word-break:break-all;">{{ url }}</a>
    </p>
{% endblock %}

{% block footer %}
    <p style="margin:0;">Tu n'as rien demandé ? Ignore ce message : ton mot de passe actuel reste valable.</p>
{% endblock %}
