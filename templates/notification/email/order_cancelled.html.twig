{% extends 'notification/layout.html.twig' %}

{% block preheader %}Ta commande {{ order.reference }} est annulée. Tu n'as rien à régler.{% endblock %}

{% block title %}Commande annulée{% endblock %}

{% block content %}
    <p style="{{ p_css }}">Bonjour{% if order.customerFirstName %} {{ order.customerFirstName }}{% endif %},</p>
    {% if actor == 'producer' %}
        <p style="{{ p_css }}">{{ shop.name }} a annulé ta commande <strong style="font-weight:600;">{{ order.reference }}</strong>, prévue {{ delivery.startsAt|date_long }}.</p>
    {% elseif actor == 'customer' %}
        <p style="{{ p_css }}">Tu as annulé ta commande <strong style="font-weight:600;">{{ order.reference }}</strong> chez {{ shop.name }}, prévue {{ delivery.startsAt|date_long }}.</p>
    {% else %}
        <p style="{{ p_css }}">Ta commande <strong style="font-weight:600;">{{ order.reference }}</strong> chez {{ shop.name }}, prévue {{ delivery.startsAt|date_long }}, a été annulée.</p>
    {% endif %}
    <p style="{{ p_css }}">Tu n'as rien à régler ni à venir chercher.</p>
    {% if actor == 'producer' %}
        <p style="{{ p_css }}">Une question ? Contacte directement {{ shop.name }}{% if shop.phone %} au {{ shop.phone }}{% endif %}.</p>
    {% endif %}
    <p style="{{ p_css }}">Envie de recommander ? Les prochaines ventes sont sur <a href="{{ shop_url }}" style="{{ link_css }}">la page de {{ shop.name }}</a>.</p>
{% endblock %}

{% block footer %}{{ include('notification/_customer_footer.html.twig') }}{% endblock %}
