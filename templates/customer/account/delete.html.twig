{% extends 'layout/customer.html.twig' %}

{% block title %}Supprimer mon compte{% endblock %}

{% set content_width = 'max-w-xl' %}

{% block content %}
    <a href="{{ path('customer_account') }}" class="mb-6 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-sage-dark">
        <twig:ux:icon name="lucide:arrow-left" class="size-4" />
        Retour à mon compte
    </a>

    <h1 class="text-3xl leading-tight font-semibold text-ink">Supprimer ton compte</h1>
    <p class="mt-3 leading-relaxed text-ink-soft">Tu peux partir quand tu veux. Voici ce qui se passe si tu confirmes :</p>

    <ul class="mt-5 flex flex-col gap-3 rounded-xl bg-white p-5 text-sm leading-relaxed text-ink shadow-card ring-1 ring-line">
        <li class="flex gap-3"><twig:ux:icon name="lucide:user" class="mt-0.5 size-4 shrink-0 text-sage-dark" /> Ton prénom, ton nom, ton téléphone et ton e-mail sont effacés.</li>
        <li class="flex gap-3"><twig:ux:icon name="lucide:bell" class="mt-0.5 size-4 shrink-0 text-sage-dark" /> Tu ne suis plus aucun producteur et tu ne reçois plus d'e-mail.</li>
        {% if has_orders %}
            <li class="flex gap-3" data-anonymisation-notice><twig:ux:icon name="lucide:receipt-text" class="mt-0.5 size-4 shrink-0 text-sage-dark" /> Tes commandes restent dans les comptes de tes producteurs, mais sans ton nom : elles deviennent anonymes.</li>
        {% endif %}
    </ul>

    {{ form_start(form, {action: path('customer_account_delete'), attr: {class: 'mt-6'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.confirm) }}
        <div class="flex flex-col gap-3 sm:flex-row">
            <twig:Button type="submit" variant="destructive">
                <twig:ux:icon name="lucide:trash-2" />
                Supprimer définitivement
            </twig:Button>
            <twig:Button as="a" href="{{ path('customer_account') }}" variant="ghost">Finalement, je reste</twig:Button>
        </div>
    {{ form_end(form) }}
{% endblock %}
